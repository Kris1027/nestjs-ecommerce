# Copy this file to .env.development and .env.production, then fill in your values.
# The app loads .env.{NODE_ENV} automatically.

# Application
NODE_ENV=development
PORT=3000
STORE_URL=http://localhost:3002
ADMIN_URL=http://localhost:3001

# CORS (optional in development, required in production/staging — comma-separated URLs)
# CORS_ORIGIN=https://your-store.vercel.app,https://your-admin.vercel.app

# Database
DATABASE_URL="postgresql://user:password@localhost:5433/nestjs_ecommerce?schema=public"

# JWT Configuration
JWT_SECRET=your-jwt-secret-min-32-characters
JWT_REFRESH_SECRET=your-refresh-secret-min-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary (Dashboard > Settings > Access Keys)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Stripe (Dashboard > Developers > API Keys)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret

# Resend (Dashboard > API Keys)
RESEND_API_KEY=re_your-resend-api-key
EMAIL_FROM=noreply@yourdomain.com

# Redis (for BullMQ job queues)
REDIS_URL=redis://localhost:6379

# OpenTelemetry (optional — disabled by default)
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=nestjs-ecommerce-api
