# Test environment configuration
# No real secrets — dummy values that pass Zod validation
# Safe to commit (gitignore only covers .env and .env.*.local)

NODE_ENV=test
PORT=3000
STORE_URL=http://localhost:3002
ADMIN_URL=http://localhost:3001

# Test database (separate from dev)
DATABASE_URL="postgresql://user:password@localhost:5433/nestjs_ecommerce_test?schema=public"

# JWT (dummy secrets, min 32 chars)
JWT_SECRET=test-jwt-secret-key-minimum-32-chars!!
JWT_REFRESH_SECRET=test-jwt-refresh-secret-min-32-chars!!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary (mocked in E2E tests)
CLOUDINARY_CLOUD_NAME=test-cloud
CLOUDINARY_API_KEY=test-api-key
CLOUDINARY_API_SECRET=test-api-secret

# Stripe (mocked in E2E tests — sk_ prefix required by Zod)
STRIPE_SECRET_KEY=sk_test_dummy_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_test_dummy_webhook_secret

# Resend (mocked in E2E tests — re_ prefix required by Zod)
RESEND_API_KEY=re_test_dummy_resend_key
EMAIL_FROM=test@example.com

# Redis (same instance as dev, different DB usage is fine)
REDIS_URL=redis://localhost:6379
